### Create meter
# Fields: address_id, utility_type_id, service_provider_id?, serial_number, name, description?, model_name?, location?, installation_date?, initial_reading, notes?, is_active?
# Response 201 Created:
# {
#   "data": {
#     "id": 1,
#     "serial_number": "G-2024-001234",
#     "name": "Лічильник газу кухня",
#     "utility_type": { ... },
#     "service_provider": { ... },
#     ...
#   }
# }
POST {{host}}/meter
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "address_id": 1,
  "utility_type_id": 1,
  "service_provider_id": 1,
  "serial_number": "G-2024-001234",
