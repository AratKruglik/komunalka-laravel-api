### Komunalka Laravel API — HTTP Client
# Base URL: http-client.env.json
# Tokens: http-client.private.env.json (gitignored)
# Login/refresh requests auto-save tokens via response handlers

### ============================================================================
### Authentication Endpoints
### ============================================================================

### Register new user (without phone number)
# Response 200 OK:
# {
#   "data": {
#     "user": {
#       "id": 1,
#       "username": "testuser",
#       "first_name": "Олена",
#       "last_name": "Петренко",
#       "email": "test (at) example.com",
#       "phone_number": null,
#       "role": "user",
#       "auth_provider": null,
#       "email_verified": false,
#       "last_login_at": null,
#       "addresses": [],
#       "avatar_optimized_url": null,
#       "avatar_thumbnail_url": null,
#       "created_at": "2025-01-10T10:00:00.000000Z",
#       "updated_at": "2025-01-10T10:00:00.000000Z"
#     },
#     "access_token": "eyJ...",
#     "refresh_token": "abc123...",
#     "token_type": "bearer",
#     "expires_in": 3600
#   }
# }
#
# Response 422 Unprocessable Entity:
# {
#   "message": "Data validation error",
#   "errors": { "email": ["The email has already been taken."] }
# }
POST {{host}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "testuser",
  "first_name": "Олена",
  "last_name": "Петренко",
  "email": "test@example.com",
  "password": "Password123!",
  "password_confirmation": "Password123!"
}

### Register new user (with phone number)
POST {{host}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "petrenko",
  "first_name": "Олена",
  "last_name": "Петренко",
  "phone_number": "+380501234567",
  "email": "olena@example.com",
  "password": "Password123!",
  "password_confirmation": "Password123!"
}

### Login user — saves auth_token and refresh_token
# Response 200 OK:
# {
#   "data": {
#     "user": { "id": 1, "username": "testuser", ... },
#     "access_token": "eyJ...",
#     "refresh_token": "abc123...",
#     "token_type": "bearer",
#     "expires_in": 3600
#   }
# }
#
# Response 401 Unauthorized:
# { "message": "Invalid email or password" }
POST {{host}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "test@example.com",
  "password": "Password123!"
}

> {%
    client.global.set("auth_token", response.body.data.access_token);
    client.global.set("refresh_token", response.body.data.refresh_token);
%}

### Login as admin — saves admin_token
POST {{host}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@komunalka.com",
  "password": "Password123!"
}

> {%
    client.global.set("admin_token", response.body.data.access_token);
    client.global.set("refresh_token", response.body.data.refresh_token);
%}

### Refresh JWT token — saves new tokens
# Response 200 OK:
# {
#   "data": {
#     "user": { ... },
#     "access_token": "eyJ...",
#     "refresh_token": "newToken...",
#     "token_type": "bearer",
#     "expires_in": 3600
#   }
# }
#
# Response 401 Unauthorized:
# { "message": "Invalid or expired refresh token" }
POST {{host}}/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refresh_token": "{{refresh_token}}"
}

> {%
    client.global.set("auth_token", response.body.data.access_token);
    client.global.set("refresh_token", response.body.data.refresh_token);
%}

### Validate JWT token
# Response 200 OK:
# {
#   "data": {
#     "id": 1,
#     "username": "testuser",
#     "first_name": "Олена",
#     "last_name": "Петренко",
#     "email": "test (at) example.com",
#     "phone_number": "+380501234567",
#     "role": "user",
#     "auth_provider": null,
#     "email_verified": true,
#     "last_login_at": "2025-01-15T10:30:00.000000Z",
#     "addresses": [],
#     "avatar_optimized_url": null,
#     "avatar_thumbnail_url": null,
#     "created_at": "2025-01-10T10:00:00.000000Z",
#     "updated_at": "2025-01-15T10:30:00.000000Z"
#   }
# }
#
# Response 401 Unauthorized:
# { "message": "Unauthenticated." }
GET {{host}}/auth/validate-token
Accept: application/json
Authorization: Bearer {{auth_token}}

### Revoke refresh token
# Response 200 OK:
# { "message": "Token revoked successfully." }
POST {{host}}/auth/revoke-token
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "refresh_token": "{{refresh_token}}"
}

### ============================================================================
### OAuth Authentication Endpoints
### ============================================================================

### Get Google OAuth authorization URL
# Response 200 OK:
# {
#   "data": {
#     "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth?client_id=...&redirect_uri=...&response_type=code&scope=openid%20email%20profile&state=..."
#   }
# }
GET {{host}}/auth/oauth/google/authorize
Accept: application/json

### Get GitHub OAuth authorization URL
# Response 200 OK:
# {
#   "data": {
#     "authorization_url": "https://github.com/login/oauth/authorize?client_id=...&redirect_uri=...&scope=user:email&state=..."
#   }
# }
GET {{host}}/auth/oauth/github/authorize
Accept: application/json

### OAuth login with token (Google ID token or GitHub access token)
# Response 200 OK:
# {
#   "data": {
#     "user": { "id": 5, "username": "john_doe_google", "auth_provider": "google", ... },
#     "access_token": "eyJ...",
#     "refresh_token": "oauthRefreshToken...",
#     "token_type": "bearer",
#     "expires_in": 3600
#   }
# }
#
# Response 401 Unauthorized:
# { "message": "Invalid OAuth token" }
POST {{host}}/auth/oauth/login
Content-Type: application/json
Accept: application/json

{
  "provider": "google",
  "token": "your-id-token-or-access-token"
}

### OAuth callback (authorization code flow)
# Response 200 OK:
# {
#   "data": {
#     "user": { "id": 2, "username": "githubuser", "auth_provider": "github", ... },
#     "access_token": "eyJ...",
#     "refresh_token": "githubRefreshToken...",
#     "token_type": "bearer",
#     "expires_in": 3600
#   }
# }
#
# Response 400 Bad Request:
# { "message": "Invalid authorization code or state mismatch" }
POST {{host}}/auth/oauth/callback
Content-Type: application/json
Accept: application/json

{
  "provider": "github",
  "code": "authorization-code-from-provider",
  "state": "state-parameter"
}

### Link OAuth provider to existing account
# Response 200 OK:
# { "message": "OAuth provider linked successfully." }
#
# Response 400 Bad Request:
# { "message": "This account is already linked to another user" }
POST {{host}}/auth/oauth/link
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "provider": "github",
  "token": "your-access-token"
}

### Unlink OAuth provider from account
# Response 200 OK:
# { "message": "OAuth provider unlinked successfully." }
#
# Response 400 Bad Request:
# { "message": "Cannot unlink the only authentication method" }
DELETE {{host}}/auth/oauth/unlink/github
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "password": "Password123!"
}

