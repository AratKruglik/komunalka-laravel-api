### Create service provider (with tariffs)
# Fields: address_id, utility_type_id, name, description?, phone?, email?, website?, is_active?, tariffs[]?
# Tariff fields: utility_type_id, currency_id, name, base_rate, service_fee?, effective_from, effective_to?, notes?
# Response 201 Created:
# {
#   "data": {
#     "id": 2,
#     "name": "Київенерго",
#     "description": "Постачання електроенергії",
#     "utility_type": { "id": 2, "slug": "electricity", "display_name": "Електроенергія", ... },
#     "tariffs": [ { "id": 1, "name": "Базовий тариф електроенергія", "base_rate": 2.64, ... } ],
#     ...
#   }
# }
POST {{host}}/service-providers
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "address_id": 1,
  "utility_type_id": 2,
  "name": "Київенерго",
  "description": "Постачання електроенергії",
  "phone": "+380442345678",
  "email": "info@kyivenergo.ua",
  "website": "https://kyivenergo.ua",
  "is_active": true,
  "tariffs": [
    {
      "utility_type_id": 2,
      "currency_id": 1,
      "name": "Базовий тариф електроенергія",
      "base_rate": 2.64,
      "service_fee": 0.00,
      "effective_from": "2025-01-01",
      "effective_to": null,
      "notes": "До 250 кВт·год/місяць"
    }
  ]
}

### Update service provider
# Fields: utility_type_id, name, description?, phone?, email?, website?, is_active?
PUT {{host}}/service-providers/1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "utility_type_id": 1,
  "name": "Київгаз (оновлено)",
  "description": "Постачання природного газу — оновлено",
  "phone": "+380441234567",
  "email": "support@kyivgaz.ua",
  "website": "https://kyivgaz.ua",
  "is_active": true
}

### Delete service provider
# Response 200 OK:
# { "message": "Service provider deleted successfully." }
DELETE {{host}}/service-providers/1
Accept: application/json
Authorization: Bearer {{auth_token}}

