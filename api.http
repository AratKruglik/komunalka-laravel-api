### Create address
# Fields: region_id, address_type_id, city, street, building_number, apartment_number?, zip_code?, notes?, is_primary?
# Response 201 Created:
# {
#   "data": {
#     "id": 1,
#     "city": "Київ",
#     "street": "вул. Хрещатик",
#     "building_number": "1",
#     "apartment_number": "101",
#     "zip_code": "01001",
#     "notes": "Центр міста",
#     "is_primary": true,
#     "region": { "id": 9, "name": "Київська область" },
#     "address_type": { "id": 1, "name": "Квартира", ... },
#     "created_at": "2025-01-15T10:30:00.000000Z",
#     "updated_at": "2025-01-15T10:30:00.000000Z"
#   }
# }
POST {{host}}/address
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "region_id": 9,
  "address_type_id": 1,
  "city": "Київ",
  "street": "вул. Хрещатик",
  "building_number": "1",
  "apartment_number": "101",
  "zip_code": "01001",
  "notes": "Центр міста",
  "is_primary": true
}

