### Update meter
PUT {{host}}/meter/1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Лічильник газу кухня (оновлено)",
  "location": "Кухня, біля плити",
  "is_active": true
}

### Delete meter
# Response 200 OK:
# { "message": "Meter deleted successfully." }
DELETE {{host}}/meter/1
Accept: application/json
Authorization: Bearer {{auth_token}}

### Upload meter photo (multipart)
POST {{host}}/meter/1/photo
Content-Type: multipart/form-data; boundary=boundary
Accept: application/json
Authorization: Bearer {{auth_token}}

--boundary
Content-Disposition: form-data; name="photo"; filename="meter_photo.jpg"
Content-Type: image/jpeg

< ./storage/app/test/meter_photo.jpg
--boundary--

### ============================================================================
### Meter Reading Endpoints
### ============================================================================

### Create batch meter readings (with photos, multipart)
# Response 201 Created:
# {
#   "data": {
#     "readings": [
#       {
#         "id": 1,
#         "reading_value": 1345.78,
#         "reading_date": "2025-02-25",
#         "previous_reading_value": 1234.56,
#         "consumption": 111.22,
#         "notes": "Показання лютого",
#         "is_estimated": false,
#         "meter": { "id": 1, "serial_number": "G-2024-001234", ... },
#         "tariff": { "id": 1, "name": "Базовий тариф газ", ... },
#         "photos": [
#           {
#             "id": 1,
#             "original_url": "https://localhost/api/v1/meter-readings/photos/1/optimized",
#             "optimized_url": "https://localhost/api/v1/meter-readings/photos/1/optimized",
#             "thumbnail_url": "https://localhost/api/v1/meter-readings/photos/1/thumbnail"
#           }
#         ],
#         "created_at": "2025-02-25T12:00:00.000000Z",
#         "updated_at": "2025-02-25T12:00:00.000000Z"
#       }
#     ],
#     "tariff_calculations": [
#       {
#         "meter_id": 1,
#         "meter_name": "Лічильник газу кухня",
#         "consumption": 111.22,
#         "unit": "м³",
#         "base_rate": 7.96,
#         "service_fee": 0.50,
#         "total_cost": 885.81,
#         "currency_code": "UAH",
#         "currency_symbol": "₴"
#       }
#     ]
#   }
# }
POST {{host}}/meter-readings/batch
Content-Type: multipart/form-data; boundary=boundary
Accept: application/json
Authorization: Bearer {{auth_token}}

--boundary
Content-Disposition: form-data; name="readings[0][meter_id]"

1
--boundary
Content-Disposition: form-data; name="readings[0][reading_value]"

1345.78
--boundary
Content-Disposition: form-data; name="readings[0][reading_date]"

2025-02-25
--boundary
Content-Disposition: form-data; name="readings[0][notes]"

Показання лютого
--boundary
Content-Disposition: form-data; name="readings[0][is_estimated]"

false
--boundary
Content-Disposition: form-data; name="photos[0][0]"; filename="reading_photo.jpg"
Content-Type: image/jpeg

< ./storage/app/test/reading_photo.jpg
--boundary--

### Create batch meter readings (JSON, without photos)
# readings[]: { meter_id, reading_value, reading_date, notes?, is_estimated? }
POST {{host}}/meter-readings/batch
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "readings": [
    {
      "meter_id": 1,
      "reading_value": 1345.78,
      "reading_date": "2025-02-25",
      "notes": "Показання лютого",
      "is_estimated": false
    },
    {
      "meter_id": 2,
      "reading_value": 4567.89,
      "reading_date": "2025-02-25",
      "notes": null,
      "is_estimated": false
    }
  ]
}

### Get meter readings by address
GET {{host}}/meter-readings/address/1
Accept: application/json
Authorization: Bearer {{auth_token}}

### Get meter readings by address (with date filter)
GET {{host}}/meter-readings/address/1?from=2025-01-01&to=2025-02-28
Accept: application/json
Authorization: Bearer {{auth_token}}

### Get meter reading by ID
# Response 200 OK:
# {
#   "data": {
#     "id": 1,
#     "reading_value": 1345.78,
#     "reading_date": "2025-02-25",
#     "previous_reading_value": 1234.56,
#     "consumption": 111.22,
#     "notes": "Показання лютого",
#     "is_estimated": false,
#     "meter": { ... },
#     "tariff": { ... },
#     "photos": [ ... ],
#     "created_at": "2025-02-25T12:00:00.000000Z",
#     "updated_at": "2025-02-25T12:00:00.000000Z"
#   }
# }
GET {{host}}/meter-readings/1
Accept: application/json
Authorization: Bearer {{auth_token}}

### Delete meter reading
# Response 200 OK:
# { "message": "Meter reading deleted successfully." }
DELETE {{host}}/meter-readings/1
Accept: application/json
Authorization: Bearer {{auth_token}}

### Get meter reading photo (optimized, no auth required)
# Response 200 OK: Binary image data
GET {{host}}/meter-readings/photos/1/optimized
Accept: image/*

### Get meter reading photo (thumbnail, no auth required)
GET {{host}}/meter-readings/photos/1/thumbnail
Accept: image/*

