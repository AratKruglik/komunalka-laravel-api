### Create user (admin)
# Fields: username, first_name, last_name, phone_number?, email, password, password_confirmation, role (user|admin)
# Response 201 Created:
# {
#   "data": {
#     "id": 2,
#     "username": "newuser",
#     "first_name": "Іван",
#     "last_name": "Коваленко",
#     "email": "ivan (at) example.com",
#     "phone_number": "+380671234567",
#     "role": "user",
#     ...
#   }
# }
POST {{host}}/users
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{admin_token}}

{
  "username": "newuser",
  "first_name": "Іван",
  "last_name": "Коваленко",
  "phone_number": "+380671234567",
  "email": "ivan@example.com",
  "password": "Password123!",
  "password_confirmation": "Password123!",
  "role": "user"
}

### Update user profile
PUT {{host}}/users/1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "first_name": "Олена",
  "last_name": "Петренко-Іваненко",
  "phone_number": "+380509876543"
}

### Update user password
PUT {{host}}/users/1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{auth_token}}

{
  "current_password": "Password123!",
  "new_password": "NewPassword456!",
  "new_password_confirmation": "NewPassword456!"
}

### Delete user (admin)
# Response 200 OK:
# { "message": "User deleted successfully." }
DELETE {{host}}/users/1
Accept: application/json
Authorization: Bearer {{admin_token}}

### Get user avatar (no auth required)
# Response 200 OK: Binary image data
# Response 404 Not Found: No avatar uploaded
GET {{host}}/users/1/avatar
Accept: image/*

### Get user avatar thumbnail (no auth required)
GET {{host}}/users/1/avatar/thumbnail
Accept: image/*

